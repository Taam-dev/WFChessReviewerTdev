# ════════════════════════════════════════════════════════════════
# WFChessReviewerTdev — Environment Configuration Template
# ════════════════════════════════════════════════════════════════
# Copy this file to .env and customize values for your environment.
# All settings are optional — defaults are shown below.
#
# NEVER commit your actual .env file to version control!
# ════════════════════════════════════════════════════════════════

# ── Browser Settings ─────────────────────────────────────────────
# Run browser in headless mode (no visible window)?
# true = headless (faster, no UI), false = visible (easier debugging)
BROWSER_HEADLESS=false

# Slow-motion delay applied to all Playwright actions (milliseconds).
# Higher values make automation more human-like but slower.
# Recommended range: 30-200ms
SLOW_MO=50

# Default element-wait timeout (milliseconds).
# How long to wait for elements to appear before failing.
DEFAULT_TIMEOUT=30000

# Page navigation timeout (milliseconds).
# How long to wait for pages to load before failing.
NAVIGATION_TIMEOUT=60000

# ── Email Verification Settings ───────────────────────────────────
# How many seconds to wait between inbox polling attempts.
EMAIL_POLL_INTERVAL=5

# Maximum number of inbox polling attempts (5s × 60 = 5 minutes).
EMAIL_POLL_MAX_ATTEMPTS=60

# ── Logging Settings ──────────────────────────────────────────────
# Logging verbosity level.
# Options: DEBUG | INFO | WARNING | ERROR
# DEBUG shows all internal details (verbose)
# INFO shows step-by-step progress (recommended)
LOG_LEVEL=INFO