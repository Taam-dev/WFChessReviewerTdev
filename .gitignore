# ══════════════════════════════════════════════════════════════
# WFChessReviewerTdev .gitignore
# ══════════════════════════════════════════════════════════════

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# ── Virtual Environments ─────────────────────────────────────
.env
.venv
env/
venv/
ENV/
.Python

# ── Testing & Coverage ───────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# ── Type Checking ─────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json

# ── IDE & Editors ─────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Project-specific generated files ─────────────────────────
screenshots/
logs/
credentials/

# ── Keep directory structure ──────────────────────────────────
!screenshots/.gitkeep
!logs/.gitkeep
!credentials/.gitkeep

# ── Playwright ────────────────────────────────────────────────
playwright-report/
test-results/

# ── Distribution ─────────────────────────────────────────────
*.whl
*.tar.gz
MANIFEST

# ── Jupyter (if ever used) ────────────────────────────────────
.ipynb_checkpoints/